{
  "name": "openfactory",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vp run -r build",
    "build:site": "vp run @openfactory/site#build",
    "verify:site": "node scripts/verify-public-site.mjs",
    "check": "pnpm --filter @openfactory/site docs:generate && vp check",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test && node --test scripts/*.test.mjs",
    "ready": "vp check && pnpm test && vp run -r build",
    "runtime:build": "vp run @openfactory/runtime#build",
    "runtime:start": "node packages/runtime/dist/runtime.mjs serve",
    "runtime:migrate": "pnpm runtime:build && node apps/app/scripts/migrate-t3.mjs",
    "openfactory": "node packages/runtime/dist/runtime.mjs",
    "build:app": "vp run @openfactory/app#build",
    "verify:app": "node scripts/verify-app.mjs",
    "verify:visualizations": "node scripts/verify-visualizations.mjs",
    "dev:mobile": "vp run @openfactory/mobile#dev",
    "build:mobile": "vp run @openfactory/mobile#build",
    "check:mobile": "vp run @openfactory/mobile#check",
    "mcp:build": "vp run @openfactory/mcp#build",
    "mcp:start": "vp run @openfactory/mcp#start"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "playwright": "^1.64.1",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
