{
  "name": "openfactory",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run @openfactory/web#dev",
    "build": "vp run -r build",
    "check": "pnpm --filter @openfactory/web docs:generate && vp check",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test",
    "ready": "vp check && vp test && vp run -r build"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
