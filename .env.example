# Server-only settings. Never prefix these with VITE_.
# Default: ~/.config/openfactory/runtime
# OPENFACTORY_RUNTIME_DIR=/absolute/path/to/runtime
# Public origin used in webhook endpoints. The service installer sets the
# Tailscale HTTPS origin in ~/.config/openfactory/service.env when available.
OPENFACTORY_PUBLIC_URL=http://localhost:8018
# Provider executables must be installed and signed in on the runtime host.
# OPENFACTORY_CODEX_BIN=/absolute/path/to/codex
# OPENFACTORY_CLAUDE_BIN=/absolute/path/to/claude
# T3_ORIGIN and T3_TOKEN_FILE are used only by pnpm runtime:migrate.
